{
  "hooks": {
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "node \"${PLUGIN_ROOT}/runtime/aion-hook.mjs\"", "timeout": 5 }] }
    ],
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "node \"${PLUGIN_ROOT}/runtime/aion-hook.mjs\"", "timeout": 5 }] }
    ],
    "PreToolUse": [
      { "matcher": "*", "hooks": [{ "type": "command", "command": "node \"${PLUGIN_ROOT}/runtime/aion-hook.mjs\"", "timeout": 5 }] }
    ],
    "PostToolUse": [
      { "matcher": "*", "hooks": [{ "type": "command", "command": "node \"${PLUGIN_ROOT}/runtime/aion-hook.mjs\"", "timeout": 5 }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "node \"${PLUGIN_ROOT}/runtime/aion-hook.mjs\"", "timeout": 5 }] }
    ],
    "Interrupt": [
      { "hooks": [{ "type": "command", "command": "node \"${PLUGIN_ROOT}/runtime/aion-hook.mjs\"", "timeout": 2 }] }
    ],
    "SessionEnd": [
      { "hooks": [{ "type": "command", "command": "node \"${PLUGIN_ROOT}/runtime/aion-hook.mjs\"", "timeout": 2 }] }
    ]
  }
}
