# dependencies
/node_modules

# Built plugin runtime (npm run build). The plugin root is copied into Codex's cache on install, so
# the runtime is built before installing rather than committed.
/plugins/aion-presence/runtime/

# local tooling output
/.e2e/
*.tsbuildinfo
/coverage

# env files never carry credentials into the repo (Aion Presence needs none)
.env*

# misc
.DS_Store
npm-debug.log*
